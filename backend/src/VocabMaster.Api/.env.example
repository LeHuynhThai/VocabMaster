# Example environment variables for VocabMaster.Api
# Copy this to .env and fill sensitive values before running or deploying.

# ASP.NET Core
ASPNETCORE_URLS=http://0.0.0.0:5000
ASPNETCORE_ENVIRONMENT=Production

# Database - replace with your SQL Server / Azure SQL connection string
ConnectionStrings__ApplicationDbContext=Server=your_server.database.windows.net,1433;Initial Catalog=VocabMaster;User ID=YOUR_USER;Password=YOUR_PASSWORD;Encrypt=True;TrustServerCertificate=False;MultipleActiveResultSets=true;

# JWT settings
JWT__Secret=ReplaceWithYourSecretMin32Chars
JWT__Issuer=VocabMasterAPI
JWT__Audience=VocabMasterClient

# Optional: enable EF Core automatic migrations at startup
# (Program.cs calls Database.MigrateAsync())
